{"resourceType":"ValueSet","id":"vsac-2.16.840.1.113883.3.526.3.1189-20170504","meta":{"versionId":"23","lastUpdated":"2026-01-08T15:44:43.000-05:00","profile":["http://hl7.org/fhir/StructureDefinition/shareablevalueset","http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/computable-valueset-cqfm","http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/publishable-valueset-cqfm"]},"language":"en","extension":[{"url":"http://hl7.org/fhir/StructureDefinition/valueset-author","valueContactDetail":{"name":"National Committee for Quality Assurance"}},{"url":"http://hl7.org/fhir/StructureDefinition/resource-lastReviewDate","valueDate":"2026-01-08"},{"url":"http://hl7.org/fhir/StructureDefinition/valueset-effectiveDate","valueDateTime":"2017-05-04"},{"url":"http://hl7.org/fhir/StructureDefinition/artifact-effectivePeriod","valuePeriod":{"start":"2017-05-04"}}],"url":"http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1189","identifier":[{"system":"urn:ietf:rfc:3986","value":"urn:oid:2.16.840.1.113883.3.526.3.1189"}],"version":"20170504","name":"TobaccoNonUser","title":"Tobacco Non User","status":"active","experimental":false,"date":"2026-01-08T15:44:43-05:00","publisher":"National Committee for Quality Assurance","jurisdiction":[{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/data-absent-reason","valueCode":"unknown"}]}],"purpose":"(Clinical Focus: The purpose of this value set is to represent concepts for an observation of tobacco non-user status.),(Data Element Scope: This value set may use a model element related to Observation.),(Inclusion Criteria: Includes concepts that represent an observation of non-use of tobacco products, including smoking and smoke-less tobacco products such as chew, snuff, pipe, cigarette, cigar, etc.),(Exclusion Criteria: Excludes concepts that represent a current tobacco user.)","compose":{"include":[{"valueSet":["http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.2.511"]}]}}